{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://genesisprotocol.local/schemas/asset_manifest.schema.json",
  "title": "Genesis Protocol Asset Manifest",
  "type": "object",
  "required": ["schema_version", "project", "naming_convention", "export_settings", "palette", "assets"],
  "properties": {
    "schema_version": { "type": "string", "pattern": "^\\d+\\.\\d+\\.\\d+$" },
    "project": { "type": "string", "minLength": 1 },
    "naming_convention": { "const": "category_assetname_variant_LOD_version" },
    "export_settings": { "type": "object" },
    "palette": {
      "type": "array",
      "minItems": 6,
      "maxItems": 6,
      "items": {
        "type": "object",
        "required": ["name", "hex", "usage"],
        "properties": {
          "name": { "type": "string" },
          "hex": { "type": "string", "pattern": "^#[0-9A-Fa-f]{6}$" },
          "usage": { "type": "string" }
        }
      }
    },
    "assets": {
      "type": "array",
      "minItems": 1,
      "items": {
        "type": "object",
        "required": ["id", "name", "category", "variant", "LOD", "version", "formats", "size_bytes", "polycount", "texture_resolutions", "dependencies", "readme_path"],
        "properties": {
          "id": { "type": "string", "pattern": "^[a-z]+_[a-z0-9]+_[a-z0-9]+_LOD[0-2]_v\\d{2}$|^[a-z]+_[a-z0-9]+_[a-z0-9]+_[a-z0-9]+_v\\d{2}$" },
          "name": { "type": "string" },
          "category": { "enum": ["world", "biome", "character", "npc", "enemy", "boss", "prop", "tool", "ui", "vfx", "audio", "scene"] },
          "variant": { "type": "string" },
          "LOD": { "enum": ["LOD0", "LOD1", "LOD2", "NA"] },
          "version": { "type": "string", "pattern": "^v\\d{2}$" },
          "formats": { "type": "array", "items": { "type": "string" }, "minItems": 1 },
          "size_bytes": { "type": "integer", "minimum": 0 },
          "polycount": { "type": "integer", "minimum": 0 },
          "texture_resolutions": { "type": "array", "items": { "type": "string" } },
          "dependencies": { "type": "array", "items": { "type": "string" } },
          "readme_path": { "type": "string" }
        }
      }
    }
  }
}
